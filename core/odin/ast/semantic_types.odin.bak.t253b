	Atomic_Signal_Fence,
	Atomic_Store,
	Atomic_Store_Explicit,
	Atomic_Load,
	Atomic_Load_Explicit,
	Atomic_Add,
	Atomic_Add_Explicit,
	Atomic_Sub,
