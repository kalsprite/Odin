	Invalid,
	// Core builtins
	Len,
	Cap,
	Size_Of,
	Align_Of,
	Offset_Of,
	Offset_Of_By_String,
	Type_Of,
	Type_Info_Of,
	Typeid_Of,
	Swizzle,
	Complex,
	Real,
	Imag,
	Conj,
	Quaternion,
	Jmag,
	Kmag,
	// Expansion/compression
	Expand_Values,
	Compress_Values,
	// SOA operations
	Soa_Zip,
	Soa_Unzip,
	// Control flow
	Unreachable,
	// Data access
	Raw_Data,
	// Math operations
	Min,
	Max,
	Abs,
	Clamp,

	// Bit manipulation intrinsics
	Count_Ones,
	Count_Zeros,
	Count_Trailing_Zeros,
	Count_Leading_Zeros,
	Count_Trailing_Ones,
	Count_Leading_Ones,
	Reverse_Bits,
