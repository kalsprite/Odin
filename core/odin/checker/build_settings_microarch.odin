// C++: build_settings_microarch.cpp target_microarch_counts -- how many entries of
// microarch_features_list belong to each arch. The entries are stored FLAT and sliced by a
// running offset, so these counts are load-bearing, not documentation.
target_microarch_counts := [Target_Arch_Kind]int {
	.Invalid   = 0,
	.Amd64     = 131,
	.I386      = 131,
	.Arm32     = 96,
	.Arm64     = 98,
	.Wasm32    = 4,
	.Wasm64p32 = 4,
	.Riscv64   = 53,
}

